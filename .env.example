# PostgreSQL Database Connection
# Em desenvolvimento local via Docker: postgresql://postgres:postgres@localhost:5432/m7arena
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/m7arena"

# Sessão própria (ADR-011 — substitui o Auth.js v5, que caiu com a ADR-010)
AUTH_SECRET="substitua-por-um-segredo-gerado-com-openssl-rand-base64-32"

# URL pública do app. Usada para montar o redirect do OAuth e para onde o
# navegador volta depois do consentimento do Google.
APP_URL="http://localhost:3000"

# Login com Google (ADR-011).
# ONDE PEGAR: Google Cloud Console (APIs & Services → Credentials), no OAuth
# Client usado pelo projeto. O "Authorized redirect URI" precisa incluir
# exatamente o valor de GOOGLE_REDIRECT_URI abaixo.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Riot API (Server-side only - NUNCA expor no bundle client)
RIOT_API_KEY=""
