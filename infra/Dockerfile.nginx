# Nginx que serve o build estático do Vite (ADR-010)
# O build roda no container (o VPS não tem Node global) e o resultado
# vai direto para /usr/share/nginx/html.

FROM node:22-alpine AS web-builder
WORKDIR /app/web
COPY web/package*.json ./
RUN npm install
COPY web/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=web-builder /app/web/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/nginx.conf
