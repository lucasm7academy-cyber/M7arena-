# Variáveis da API Node (ADR-010 / ADR-011).
#
# Copie este arquivo para `api/.env` e preencha. Ele precisa ficar AQUI, em api/,
# porque o servidor roda com `npm run dev` de dentro desta pasta e o
# `dotenv.config()` lê o .env do diretório atual — um .env na raiz do repo não é
# enxergado por ele.
#
# api/.env NÃO vai para o git. Nenhum destes valores pode aparecer no bundle do
# front: o cliente só fala com /api/*, nunca direto com o Postgres ou com o Google.

# ── Banco ────────────────────────────────────────────────────────────────────
# Local, via Docker: postgresql://postgres:postgres@localhost:5432/m7arena
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/m7arena"

# ── Sessão ───────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# URL pública do app. Em produção vira https://m7arena.pro
APP_URL="http://localhost:3000"

# ── Login com Google ─────────────────────────────────────────────────────────
# ONDE PEGAR (as credenciais NÃO estão no código do site atual):
#
#   Caminho curto — painel do Supabase do site atual:
#     https://supabase.com/dashboard/project/bfsusctegzvfrlehhink/auth/providers
#     → abra "Google" → copie "Client ID" e "Client Secret"
#
#   Caminho de origem — Google Cloud Console:
#     https://console.cloud.google.com/apis/credentials
#     → OAuth 2.0 Client IDs → o client usado pelo Supabase
#
# IMPORTANTE: no Google Console, em "Authorized redirect URIs", adicione
# EXATAMENTE o valor de GOOGLE_REDIRECT_URI abaixo. Pode ter várias URIs no mesmo
# client, então adicionar a nossa NÃO quebra o site atual — ele continua usando a
# dele (https://bfsusctegzvfrlehhink.supabase.co/auth/v1/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── Riot ─────────────────────────────────────────────────────────────────────
# Só no servidor. O site atual expunha isso no bundle (VITE_RIOT_API_KEY).
RIOT_API_KEY=""

# ── Mercado Pago (ADR-031) ───────────────────────────────────────────────────
# Checkout Transparente, PIX. NUNCA exponha no bundle do front.
# MODO TESTE: começa com "TEST-". Em produção é APP_USR-...
MERCADO_PAGO_ACCESS_TOKEN=""
# Secret da aba Webhooks do painel do Mercado Pago (valida x-signature).
MERCADO_PAGO_WEBHOOK_SECRET=""
# URL pública HTTPS que o MP notifica. Em produção: https://dev.m7arena.pro/api/payments/webhook
MERCADO_PAGO_NOTIFICATION_URL="https://dev.m7arena.pro/api/payments/webhook"
